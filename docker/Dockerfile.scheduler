# Multi-stage Dockerfile for OptiScheduling Rust Server
FROM rust:1.85-bookworm AS builder
WORKDIR /workspace

# Copy workspace manifests
COPY Cargo.toml Cargo.lock ./
COPY optischeduling-core/Cargo.toml optischeduling-core/Cargo.toml
COPY optischeduling-cli/Cargo.toml optischeduling-cli/Cargo.toml
COPY optischeduling-server/Cargo.toml optischeduling-server/Cargo.toml

# Copy sources
COPY optischeduling-core optischeduling-core
COPY optischeduling-cli optischeduling-cli
COPY optischeduling-server optischeduling-server

# Build release server and CLI binaries
RUN cargo build --release -p optischeduling-server -p optischeduling-cli

# Runtime stage
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app

COPY --from=builder /workspace/target/release/optischeduling-server /usr/local/bin/optischeduling-server
COPY --from=builder /workspace/target/release/optischeduling-cli /usr/local/bin/optischeduling-cli

ENV PORT=8085
ENV HOST=0.0.0.0
ENV RUST_LOG=info

EXPOSE 8085
HEALTHCHECK --interval=5s --timeout=3s --retries=5 CMD curl -f http://localhost:8085/health || exit 1

CMD ["optischeduling-server"]
